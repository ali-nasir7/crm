# Android Phone Bridge configuration.
# Copy this file to .env (same folder as android-bridge.js) and fill it in.
# Environment variables with the same names override the file.

# REQUIRED. Shared secret. Must be EXACTLY the same value as CRM_BRIDGE_TOKEN
# on the backend (.env of the CRM). The bridge refuses to start without it.
BRIDGE_TOKEN=change-this-bridge-token

# Device ID of YOUR phone from the CRM: Calls page > My calling devices > copy the id.
# This is how the CRM knows which registered phone this bridge dials.
BRIDGE_DEVICE_ID=paste-your-crm-device-id-here

# Where the CRM backend API lives (for heartbeat + call-state push).
# Backend via "mvn spring-boot:run" on the same PC:  http://localhost:8080/api/v1
CRM_API_URL=http://localhost:8080/api/v1

# URL the CRM backend uses to reach THIS bridge. Use host.docker.internal when the
# backend runs inside Docker; use 127.0.0.1 when it runs directly on this PC.
# BRIDGE_PUBLIC_URL=http://host.docker.internal:9090

# Port/host to listen on. Token is always required, so 0.0.0.0 stays safe.
# BRIDGE_PORT=9090
# BRIDGE_HOST=0.0.0.0

# adb executable (found on PATH by default; or give the full path to adb.exe).
# ADB_PATH=C:\platform-tools\adb.exe

# Pin a specific phone when several are connected (see: adb devices).
# ANDROID_SERIAL=R58N1234ABC

# Wireless debugging (Android 11+): pair once with "adb pair ip:port", then set:
# ADB_CONNECT=192.168.1.50:5555
